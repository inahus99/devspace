# --- Required ---------------------------------------------------------------
# Postgres connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://devspace:devspace@localhost:5433/devspace

# Long random string used to sign session tokens (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Allow new accounts to be registered. The very first account can always be
# created; after that, sign-up is closed unless this is "true".
ALLOW_REGISTRATION=false

# Upload storage driver: "disk" (default) or "s3"
STORAGE_DRIVER=disk
# Disk driver: directory for uploads. On Railway, mount a Volume and point here.
UPLOAD_DIR=./uploads
# Max upload size in megabytes
MAX_UPLOAD_MB=25

# S3-compatible driver (Railway Buckets, Cloudflare R2, AWS S3, MinIO ...)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
